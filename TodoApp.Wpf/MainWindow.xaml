<Window x:Class="TodoApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оконный менеджер задач - WPF"
        Width="820" Height="540" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Background="#F3F5F9">
    <Window.Resources>
        <Style x:Key="TaskTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#243047" />
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="#7A8494" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Оконный менеджер задач" FontSize="26" FontWeight="SemiBold"
                       Foreground="#243047" />
            <TextBlock Text="Список дел" Margin="0,6,0,0" Foreground="#687487" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Добавить" Click="AddButton_Click" />
            <Button x:Name="EditButton" Content="Редактировать" IsEnabled="False"
                    Click="EditButton_Click" />
            <Button x:Name="DeleteButton" Content="Удалить выбранное" IsEnabled="False"
                    Click="DeleteButton_Click" Margin="0" />
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE1EA"
                BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <ListBox x:Name="TasksList" BorderThickness="0"
                         Background="Transparent" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TasksList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          ToolTip="Отметить выполнение задачи" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               Style="{StaticResource TaskTitleStyle}" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Создана: {0:dd.MM.yyyy HH:mm}'}"
                                               Margin="0,5,0,0" FontSize="12"
                                               Foreground="#7A8494" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Text="Пока нет задач"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7A8494" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <TextBlock x:Name="StatisticsText" Grid.Row="3" Margin="0,16,0,0"
                   Foreground="#243047" FontWeight="SemiBold" />
    </Grid>
</Window>

